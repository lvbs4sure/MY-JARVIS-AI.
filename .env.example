# Copy to .env. NEVER commit your .env or secrets.
# Local-first default: install Ollama and run: ollama pull llama3.2:3b
JARVIS_PROVIDER=ollama
# Optional Gemini outage fallback. Requires a running local Ollama model.
JARVIS_OLLAMA_FALLBACK=off
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434
# Optional online model: set JARVIS_PROVIDER=gemini
GEMINI_API_KEY=
# Model verified in a Windows live-chat test; availability can change.
GEMINI_MODEL=gemini-flash-lite-latest
# Optional voice input (uploads audio to Gemini): set to gemini
JARVIS_VOICE_PROVIDER=off
JARVIS_NAME=JARVIS
